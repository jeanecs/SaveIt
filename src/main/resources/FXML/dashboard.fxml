<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="saveit.controller.DashboardController"
      spacing="20"
      style="-fx-padding: 20;"
      prefHeight="900">


    <!-- TOP CARDS -->
    <HBox spacing="20">

        <!-- TOTAL INCOME CARD -->
        <VBox spacing="12"
              HBox.hgrow="ALWAYS"
              maxWidth="Infinity"
              style="
              -fx-background-radius: 20;
              -fx-padding: 20;
              -fx-background-color: linear-gradient(to bottom right, #00BFA6, #00BFA6CC);
              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 8, 0, 0, 2);
          ">

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Total Income"
                       style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.8);" />

                <!-- Icon Box -->
                <StackPane style="
                -fx-background-color: rgba(255,255,255,0.2);
                -fx-background-radius: 15;
                -fx-min-width: 45;
                -fx-min-height: 45;
                -fx-alignment: center;">
                    <Label text="💰" style="-fx-font-size: 22px;" />
                </StackPane>
            </HBox>

            <Label fx:id="totalIncomeLabel"
                   text="₱0.00"
                   style="-fx-font-size: 30px; -fx-text-fill: white; -fx-font-weight: bold;" />

            <HBox spacing="5" alignment="CENTER_LEFT">
                <Label text="↑" style="-fx-font-size: 16px; -fx-text-fill: white;" />
                <Label text="+12% from last month"
                       style="-fx-text-fill: rgba(255,255,255,0.9);" />
            </HBox>
        </VBox>


        <!-- TOTAL EXPENSES CARD -->
        <VBox spacing="12"
              HBox.hgrow="ALWAYS"
              maxWidth="Infinity"
              style="
              -fx-background-radius: 20;
              -fx-padding: 20;
              -fx-background-color: linear-gradient(to bottom right, #F9A826, #F9A826CC);
              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 8, 0, 0, 2);
          ">

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Total Expenses"
                       style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.8);" />

                <StackPane style="
                -fx-background-color: rgba(255,255,255,0.2);
                -fx-background-radius: 15;
                -fx-min-width: 45;
                -fx-min-height: 45;
                -fx-alignment: center;">
                    <Label text="💸" style="-fx-font-size: 22px;" />
                </StackPane>
            </HBox>

            <Label fx:id="totalExpenseLabel"
                   text="₱0.00"
                   style="-fx-font-size: 30px; -fx-text-fill: white; -fx-font-weight: bold;" />

            <HBox spacing="5" alignment="CENTER_LEFT">
                <Label text="↓" style="-fx-font-size: 16px; -fx-text-fill: white;" />
                <Label text="-5% from last month"
                       style="-fx-text-fill: rgba(255,255,255,0.9);" />
            </HBox>
        </VBox>


        <!-- BALANCE CARD -->
        <VBox spacing="12"
              HBox.hgrow="ALWAYS"
              maxWidth="Infinity"
              style="
              -fx-background-radius: 20;
              -fx-padding: 20;
              -fx-background-color: linear-gradient(to bottom right, #2F4858, #2F4858CC);
              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 8, 0, 0, 2);
          ">

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Balance Remaining"
                       style="-fx-font-size: 14px; -fx-text-fill: rgba(255,255,255,0.8);" />

                <StackPane style="
                -fx-background-color: rgba(255,255,255,0.2);
                -fx-background-radius: 15;
                -fx-min-width: 45;
                -fx-min-height: 45;
                -fx-alignment: center;">
                    <Label text="💼" style="-fx-font-size: 22px;" />
                </StackPane>
            </HBox>

            <Label fx:id="balanceLabel"
                   text="₱0.00"
                   style="-fx-font-size: 30px; -fx-text-fill: white; -fx-font-weight: bold;" />

            <HBox spacing="5" alignment="CENTER_LEFT">
                <Label text="↑" style="-fx-font-size: 16px; -fx-text-fill: white;" />
                <Label text="+8% from last month"
                       style="-fx-text-fill: rgba(255,255,255,0.9);" />
            </HBox>
        </VBox>

    </HBox>

    <!-- CHARTS - INCREASED HEIGHT -->
    <HBox spacing="20" VBox.vgrow="ALWAYS" maxWidth="Infinity">
        <VBox spacing="10" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Expense Categories"
                   style="-fx-font-size:16px; -fx-font-weight:bold; -fx-text-fill: #2F4858;"/>
            <PieChart fx:id="expensePieChart"
                      HBox.hgrow="ALWAYS"
                      VBox.vgrow="ALWAYS"
                      maxWidth="Infinity"
                      prefHeight="320"
                      legendVisible="false"
                      labelsVisible="true"
                      style="-fx-background-color: white;
                         -fx-background-radius: 20;
                         -fx-padding: 20;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8,0,0,2);"/>
        </VBox>

        <VBox spacing="10" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" maxWidth="Infinity">
            <Label text="Monthly Income vs Expenses"
                   style="-fx-font-size:16px; -fx-font-weight:bold; -fx-text-fill: #2F4858;"/>
            <BarChart fx:id="monthlyBarChart"
                      HBox.hgrow="ALWAYS"
                      VBox.vgrow="ALWAYS"
                      maxWidth="Infinity"
                      prefHeight="320"
                      categoryGap="30"
                      barGap="5"
                      legendVisible="true"
                      legendSide="BOTTOM"
                      style="-fx-background-color: white;
                         -fx-background-radius: 20;
                         -fx-padding: 20;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8,0,0,2);">
                <xAxis>
                    <CategoryAxis side="BOTTOM" tickLabelFill="#666666"/>
                </xAxis>
                <yAxis>
                    <NumberAxis side="LEFT" tickLabelFill="#666666" minorTickVisible="false"/>
                </yAxis>
            </BarChart>
        </VBox>
    </HBox>

    <!-- RECENT TRANSACTIONS TABLE -->
    <VBox spacing="10" VBox.vgrow="ALWAYS"
          style="
          -fx-background-color: white;
          -fx-padding: 20;
          -fx-background-radius: 20;
          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8,0,0,2);
      ">

        <Label text="Recent Transactions"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2F4858;" />

        <TableView fx:id="recentTransactionsTable"
                   VBox.vgrow="ALWAYS"
                   style="-fx-background-color: transparent; -fx-border-color: transparent;">

            <columns>
                <TableColumn fx:id="dateCol" text="Date" prefWidth="120" />
                <TableColumn fx:id="categoryCol" text="Category" prefWidth="150"/>
                <TableColumn fx:id="typeCol" text="Type" prefWidth="120"/>
                <TableColumn fx:id="amountCol" text="Amount" prefWidth="120"/>
                <TableColumn fx:id="notesCol" text="Notes" prefWidth="300"/>
                <TableColumn fx:id="actionCol" text="Actions" prefWidth="100" minWidth="100" maxWidth="120" />

            </columns>

        </TableView>
    </VBox>


</VBox>
