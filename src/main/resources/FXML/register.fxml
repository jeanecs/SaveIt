<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="saveit.controller.RegisterController"
            stylesheets="@../CSS/login.css">

    <!-- Gradient Background: Anchored to fill the entire window -->
    <StackPane styleClass="login-root"
               AnchorPane.bottomAnchor="0.0"
               AnchorPane.leftAnchor="0.0"
               AnchorPane.rightAnchor="0.0"
               AnchorPane.topAnchor="0.0">
        <!-- Abstract Shapes for subtle background effect -->
        <Pane styleClass="bg-shape shape1"/>
        <Pane styleClass="bg-shape shape2"/>

        <!-- Center Content -->
        <VBox alignment="CENTER" spacing="30" styleClass="login-container">

            <!-- Logo & Title Section (Centered above the card) -->
            <VBox alignment="CENTER" spacing="8">
                <!-- This HBox ensures the fixed-size logo remains centered -->
                <HBox alignment="CENTER">
                    <StackPane styleClass="logo-outer">
                        <StackPane styleClass="logo-inner">
                            <Label text="💰" styleClass="logo-icon"/>
                        </StackPane>
                    </StackPane>
                </HBox>
                <Label text="BudgetBuddy 💰" styleClass="title"/>
                <Label text="Start tracking your expenses today!"
                       styleClass="subtitle"/>
            </VBox>

            <!-- Registration Card -->
            <VBox styleClass="card" spacing="18">
                <Label text="Create Your Account" styleClass="card-title"/>

                <Label fx:id="messageLabel" text="" styleClass="message"/>

                <!-- Username Field -->
                <VBox spacing="8">
                    <Label text="Username" styleClass="form-label"/>
                    <TextField fx:id="usernameField" promptText="Choose a unique username"
                               styleClass="input"/>
                </VBox>

                <!-- Email Field (New) -->
                <VBox spacing="8">
                    <Label text="Email" styleClass="form-label"/>
                    <TextField fx:id="emailField" promptText="Enter your email address"
                               styleClass="input"/>
                </VBox>

                <!-- Password Field -->
                <VBox spacing="8">
                    <Label text="Password" styleClass="form-label"/>
                    <PasswordField fx:id="passwordField" promptText="Create a secure password"
                                   styleClass="input"/>
                </VBox>

                <!-- Confirm Password Field (New) -->
                <VBox spacing="8">
                    <Label text="Confirm Password" styleClass="form-label"/>
                    <PasswordField fx:id="confirmPasswordField" promptText="Re-enter your password"
                                   styleClass="input"/>
                </VBox>

                <!-- Register Button -->
                <Button text="Register" onAction="#handleRegister"
                        styleClass="btn-primary"/>

                <!-- Login Link -->
                <Button text="Already have an account? Log in" onAction="#handleLogin"
                        styleClass="toggle-link"/>
            </VBox>

            <!-- Footer -->
            <Label text="Secure • Private • Easy to use"
                   styleClass="footer"/>

        </VBox>
    </StackPane>
</AnchorPane>