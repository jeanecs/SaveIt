<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx/21.0.2"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="saveit.controller.SidebarController"
      spacing="10" prefWidth="200"
      style="-fx-background-color: white; -fx-border-color: #F0F0F0; -fx-padding: 20;">

    <Label text="💰 SaveIT"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2F4858;"/>

    <Button text="🏠 Dashboard" onAction="#handleDashboard"
            style="-fx-background-color: transparent; -fx-text-fill: #2F4858; -fx-font-size: 14px;"/>
    <Button text="➕ Add Transaction" onAction="#handleAddTransaction"
            style="-fx-background-color: transparent; -fx-text-fill: #2F4858; -fx-font-size: 14px;"/>
    <Button text="📊 Reports" onAction="#handleReports"
            style="-fx-background-color: transparent; -fx-text-fill: #2F4858; -fx-font-size: 14px;"/>
    <Button text="🚪 Logout" onAction="#handleLogout"
            style="-fx-background-color: transparent; -fx-text-fill: #F45B69; -fx-font-size: 14px;"/>
</VBox>
