<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/21.0.2"
      xmlns:fx="http://javafx.com/fxml/1"
      alignment="TOP_LEFT"
      spacing="20"
      padding="20">

    <Label text="Inventory Management" styleClass="page-title"/>
    <Label text="Inventory page content goes here."/>

    <!-- Example Table -->
    <TableView prefHeight="400" prefWidth="600">
        <columns>
            <TableColumn text="Item ID"/>
            <TableColumn text="Item Name"/>
            <TableColumn text="Quantity"/>
            <TableColumn text="Price"/>
        </columns>
    </TableView>

</VBox>
