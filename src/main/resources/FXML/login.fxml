<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="saveit.controller.LoginController"
            stylesheets="@../CSS/login.css">

    <!-- Gradient Background: Anchored to fill the entire window -->
    <StackPane styleClass="login-root"
               AnchorPane.bottomAnchor="0.0"
               AnchorPane.leftAnchor="0.0"
               AnchorPane.rightAnchor="0.0"
               AnchorPane.topAnchor="0.0">
        <!-- Abstract Shapes for subtle background effect -->
        <Pane styleClass="bg-shape shape1"/>
        <Pane styleClass="bg-shape shape2"/>

        <!-- Center Content -->
        <VBox alignment="CENTER" spacing="30" styleClass="login-container">

            <!-- Logo & Title Section (Centered above the card) -->
            <VBox alignment="CENTER" spacing="8">
                <!-- WRAPPED IN HBOX: This is kept to center the logo since it has a fixed size -->
                <HBox alignment="CENTER">
                    <!-- Outer white rounded box (logo-outer) and inner teal rounded box (logo-inner) -->
                    <StackPane styleClass="logo-outer">
                        <StackPane styleClass="logo-inner">
                            <Label text="💰" styleClass="logo-icon"/>
                        </StackPane>
                    </StackPane>
                </HBox>
                <Label text="SaveIT 💰" styleClass="title"/>
                <Label text="Track your expenses. Grow your savings."
                       styleClass="subtitle"/>
            </VBox>

            <!-- Card -->
            <VBox styleClass="card" spacing="20">
                <Label text="Welcome Back" styleClass="card-title"/>

                <Label fx:id="messageLabel" text="" styleClass="message"/>

                <VBox spacing="8">
                    <Label text="Username" styleClass="form-label"/>
                    <!-- Inputs naturally stretch in a VBox, but we ensure they are always full width -->
                    <TextField fx:id="usernameField" promptText="Enter your username"
                               styleClass="input" VBox.vgrow="NEVER" HBox.hgrow="ALWAYS"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Password" styleClass="form-label"/>
                    <!-- Inputs naturally stretch in a VBox, but we ensure they are always full width -->
                    <PasswordField fx:id="passwordField" promptText="Enter your password"
                                   styleClass="input" VBox.vgrow="NEVER" HBox.hgrow="ALWAYS"/>
                </VBox>

                <!-- Button is now directly in the card's VBox to allow it to stretch to the VBox width -->
                <Button text="Login" onAction="#handleLogin" maxWidth="Infinity"
                        styleClass="btn-primary"/>

                <!-- Secondary button (link style) -->
                <Button text="Don't have an account? Create one" onAction="#handleRegister"
                        styleClass="toggle-link"/>
            </VBox>

            <!-- Footer -->
            <Label text="Secure • Private • Easy to use"
                   styleClass="footer"/>

        </VBox>
    </StackPane>
</AnchorPane>