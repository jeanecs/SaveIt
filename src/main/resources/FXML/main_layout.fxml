<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?> <!-- Important for padding -->


<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="saveit.controller.MainLayoutController"
            prefWidth="800" prefHeight="600">


    <!-- Top header -->
    <top>
        <HBox spacing="10" style="-fx-background-color: white; -fx-padding: 10;">
            <Label fx:id="welcomeLabel" text="Welcome!" style="-fx-font-size: 16px;"/>
        </HBox>
    </top>

    <!-- Left sidebar (hardcoded) -->
    <left>
        <VBox spacing="10" prefWidth="200"
              style="-fx-background-color: white; -fx-border-color: #F0F0F0; -fx-padding: 20;">

            <Label text="💰 SaveIT"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2F4858;"/>

            <Button text="🏠 Dashboard" onAction="#showDashboard"
                    style="-fx-background-color: transparent; -fx-text-fill: #2F4858; -fx-font-size: 14px;"/>
            <Button text="➕ Add Transaction" onAction="#showAddTransaction"
                    style="-fx-background-color: transparent; -fx-text-fill: #2F4858; -fx-font-size: 14px;"/>
            <Button text="📊 Reports" onAction="#showReports"
                    style="-fx-background-color: transparent; -fx-text-fill: #2F4858; -fx-font-size: 14px;"/>
            <Button text="🚪 Logout" onAction="#handleLogout"
                    style="-fx-background-color: transparent; -fx-text-fill: #F45B69; -fx-font-size: 14px;"/>
        </VBox>
    </left>

    <!-- Main content area -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #F8FAFB;"/>
    </center>

</BorderPane>
