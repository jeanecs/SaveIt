<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>


<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="saveit.controller.MainLayoutController"
            stylesheets="@../CSS/main.css">

    <!-- Top header -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="top-header">
            <!-- 1. Logo/App Name (Moved from sidebar) -->
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="sidebar-logo">
                <StackPane styleClass="logo-icon-container">
                    <Label text="💰" styleClass="logo-icon-text"/>
                </StackPane>
                <Label text="SaveIT" styleClass="logo-text"/>
            </HBox>

            <!-- Spacer to push items to the right -->
            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="usernameLabel" text="[Loading Username...]" styleClass="user-account-label"/>

            <!-- Profile Icon (Circle with initial 'T') -->
            <StackPane styleClass="profile-circle">
                <Circle radius="15" styleClass="profile-background"/>
                <Label fx:id="profileInitialLabel" text="T" styleClass="profile-initial-text"/>
            </StackPane>

            <!-- Logout Button -->
            <Button text="Logout 🚪" onAction="#handleLogout" styleClass="logout-button"/>
        </HBox>
    </top>


    <!-- Left sidebar (hardcoded) -->
    <left>
        <VBox styleClass="sidebar">
            <!-- 2. Navigation Buttons (Now at the top) -->
            <VBox spacing="5" styleClass="nav-buttons-container">

                <!-- Dashboard (Active State) -->
                <Button fx:id="dashboardButton" text="🏠  Dashboard" onAction="#showDashboard"
                        styleClass="nav-button, secondary"/>

                <!-- Add Transaction -->
                <Button fx:id="addTransactionButton" text="➕  Add Transaction" onAction="#showAddTransaction"
                        styleClass="nav-button, secondary"/>

                <Button fx:id="AllTransactionsButton" text="➕  All Transactions" onAction="#showAllTransactions"
                        styleClass="nav-button, secondary"/>

                <!-- Budget Manager -->
                <Button fx:id="budgetButton" text="🎯  Budget Manager" onAction="#showBudget"
                        styleClass="nav-button, secondary"/>

                <!-- NEW: Settings Button -->
                <Button fx:id="settingsButton" text="&#x2699;  Settings" onAction="#showSettings"
                        styleClass="nav-button, secondary"/>

            </VBox>
            <!-- Removed spacers to keep buttons at the top -->
        </VBox>
    </left>

    <!-- Main content area -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #F8FAFB; -fx-background: #F8FAFB;">
            <StackPane fx:id="contentArea" style="-fx-background-color: #F8FAFB;"/>
        </ScrollPane>
    </center>

</BorderPane>
